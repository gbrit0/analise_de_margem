DB_NAME='<nome_banco_de_dados>'
DB_USER='<usuario>'
DB_PASSWORD='<senha>'
DB_HOST='<host>'
DB_PORT=<porta>

PROTHEUS_ODBC_DRIVER="ODBC Driver 17 for SQL Server"
PROTHEUS_DB_USER="<usuario_bd_protheus>"
PROTHEUS_DB_PASSWORD="<senha>"
PROTHEUS_DB_HOST="<host>,<porta>"
PROTHEUS_DB_DATABASE="<nome_bd_protheus>"

# Usuário padrão do sistema. Diferente do admin definido em pyrhon manage.py createsuperuser.
USER_SYSTEM=system
PASS_SYSTEM=<senha para usuario system>

# Superadmin
USER_ADMIN=<usuario admin>
PASS_ADMIN=<senha admin>

REDIS_HOST=<host_redis>
REDIS_PORT=<porta_redis

# True para desenvolvimento False para produção
DEBUG=True

# True para desenvolvimento False para produção
CSRF_COOKIE_SECURE=False

# True para desenvolvimento False para produção
SESSION_COOKIE_SECURE=False

# Configuração de subrota (produção)
FORCE_SCRIPT_NAME=/analise_de_margem
CSRF_TRUSTED_ORIGINS=https://portal.brggeradores.com.br,https://margem.brggeradores.com.br

# --- Keycloak ---
# O client_id deve ser idêntico ao prefixo da rota no portal (/analise_de_margem)
OIDC_RP_CLIENT_ID=analise_de_margem
OIDC_RP_CLIENT_SECRET=<secret do client no keycloak>
KEYCLOAK_SERVER_URL=https://keycloak.brggeradores.com.br
KEYCLOAK_REALM=brg-brasil-geradores

# --- SSO com o portal unificado ---
# Lê o token que o portal já gravou no navegador e dispensa um segundo login.
KEYCLOAK_PORTAL_SSO_ENABLED=True
KEYCLOAK_PORTAL_COOKIE_NAME=brg_access_token

# Desabilite apenas se o audience mapper do client ainda não estiver criado no Keycloak
KEYCLOAK_VERIFY_AUDIENCE=True
KEYCLOAK_VERIFY_ISSUER=True
KEYCLOAK_JWKS_CACHE_SECONDS=3600
KEYCLOAK_LEEWAY=30
KEYCLOAK_JWKS_TIMEOUT=10
# O Cloudflare, na frente do Keycloak, responde 403 ao User-Agent padrão do
# urllib: sem UA próprio o JWKS não é baixado e nenhum token é validado.
KEYCLOAK_JWKS_USER_AGENT=analise_de_margem/1.0

# False: as roles do Keycloak só PROMOVEM (não rebaixam o superusuário local que
# administra as justificativas). True: o Keycloak passa a ser a única fonte de
# verdade e revogar a role lá revoga o acesso aqui.
KEYCLOAK_ESPELHA_PERMISSOES=False

# Para onde vai quem está sem sessão ou com o token vencido. Nunca o Keycloak.
PORTAL_URL=https://portal.brggeradores.com.br
PORTAL_LOGOUT_URL=https://portal.brggeradores.com.br/logout

# Endpoint do portal que renova o cookie do token, e de quanto em quanto tempo a
# tela o chama. O access token vive 5 minutos: sem esse ping o nginx barra quem
# está trabalhando, mesmo com a sessão do Django de pé.
PORTAL_REFRESH_URL=/auth/refresh
PORTAL_REFRESH_INTERVALO_SEGUNDOS=60

# DEBUG para investigar tokens rejeitados
LOG_LEVEL=INFO